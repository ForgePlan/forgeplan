---
// Starlight Header override — replaces Starlight's default top bar
// with our DocsHeader on /docs/* for unified site-wide navigation.
// Loaded via astro.config.mjs `starlight.components.Header`.
//
// IMPORTANT: DO NOT import '../styles/global.css' here. global.css contains
// `@import "tailwindcss"` whose preflight `* { padding: 0 }` is UNLAYERED
// and overrides Starlight's `@layer starlight.core` rule
// `.main-frame { padding-inline-start: var(--sl-content-inline-start) }`,
// which collapses the docs layout (sidebar overlaps content).
// Forge palette tokens used by DocsHeader live in forge-theme.css (loaded
// as Starlight customCss), keeping /docs free of Tailwind preflight.
//
// DocsHeader also renders INLINE content (no outer <header>, no
// position:fixed) — Starlight already provides the outer <header.header>
// wrapper. Nesting <header> here collapses /docs layout differently
// (article 19px).
import DocsHeader from './DocsHeader.astro';
---
<DocsHeader />
