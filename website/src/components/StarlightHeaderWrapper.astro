---
// Starlight Header override — replaces Starlight's default top bar
// with our site Header.astro for unified site-wide navigation on /docs/*.
// Loaded via astro.config.mjs `starlight.components.Header`.
//
// Starlight passes layout props but we just render our standalone Header.
// Starlight's mobile sidebar trigger lives in MobileTableOfContents/Sidebar —
// users can still toggle docs sidebar via that component (Starlight default).
import Header from './Header.astro';
import '../styles/global.css';
---
<Header />
