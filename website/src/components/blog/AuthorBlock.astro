---
interface Props {
  lang?: 'en' | 'ru';
}
const { lang = 'en' } = Astro.props;
const eyebrow = lang === 'ru' ? 'Автор' : 'Author';
---
<address class="blog-author">
  <p class="blog-author-eyebrow">{eyebrow}</p>
  <p class="blog-author-name">Mike Kubal</p>
  <a href="https://elirum.me" rel="external noopener" target="_blank" class="blog-author-link">elirum.me →</a>
</address>
