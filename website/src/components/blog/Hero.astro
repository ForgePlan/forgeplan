---
interface Props {
  cover?: string;
  coverAlt?: string;
  topic: string;
  kind: string;
  title: string;
}
const { cover, coverAlt, topic, kind, title } = Astro.props;
---
{cover ? (
  <div class={`blog-hero blog-hero-cover blog-hero-topic-${topic}`}>
    <div class="blog-hero-image">
      <img
        src={cover}
        alt={coverAlt ?? ''}
        class="blog-hero-img"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1280"
        height="624"
      />
    </div>
    <div class="blog-hero-meta">
      <p class="eyebrow">{kind} · {topic}</p>
      <h1 class="blog-hero-title">{title}</h1>
    </div>
  </div>
) : (
  <div class={`blog-hero blog-hero-css blog-hero-topic-${topic}`}>
    <p class="eyebrow">{kind} · {topic}</p>
    <h1 class="blog-hero-title">{title}</h1>
    <div class="blog-hero-stripe"></div>
  </div>
)}
