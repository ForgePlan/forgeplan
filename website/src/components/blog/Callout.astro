---
interface Props {
  type: 'info' | 'warn' | 'tip' | 'danger';
}
const { type } = Astro.props;
const isRu = Astro.url.pathname.startsWith('/ru/');

const config = {
  info:   { icon: 'ℹ',  label: isRu ? 'Информация' : 'Info' },
  warn:   { icon: '⚠',  label: isRu ? 'Предупреждение' : 'Warning' },
  tip:    { icon: '✓',  label: isRu ? 'Совет' : 'Tip' },
  danger: { icon: '✕',  label: isRu ? 'Опасность' : 'Danger' },
};
const { icon, label } = config[type];
---
<aside class={`blog-callout blog-callout-${type}`} role="note" aria-label={label}>
  <span class="blog-callout-icon" aria-hidden="true">{icon}</span>
  <div class="blog-callout-content">
    <slot />
  </div>
</aside>
