---
import Landing from '../../layouts/Landing.astro';
import Header from '../../components/Header.astro';
import BlogFooter from '../../components/blog/BlogFooter.astro';
import SiteJsonLd from '../../components/SiteJsonLd.astro';
import { guides, getGuide } from '../../data/guides.ts';
import '../../styles/blog-theme.css';

export async function getStaticPaths() {
  return guides.map(g => ({ params: { slug: g.slug } }));
}

const { slug } = Astro.params;
const guide = getGuide(slug as string);
if (!guide) throw new Error(`Guide not found: ${slug}`);

const site = Astro.site ?? new URL('https://forgeplan.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const altRu = new URL(`/ru/guides/${slug}`, site).href;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: guide.title_en,
  description: guide.desc_en,
  url: canonical,
  inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'Forgeplan', url: site.href },
  learningResourceType: guide.pill === 'interactive' ? 'Interactive Resource' : 'Lesson',
  educationalLevel: 'Intermediate',
  audience: { '@type': 'Audience', audienceType: 'Software developers, AI engineers' },
};
const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Forgeplan', item: site.href },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides/', site).href },
    { '@type': 'ListItem', position: 3, name: guide.title_en, item: canonical },
  ],
};
const safeJson = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026');

// Prev/next in reading order
const ordered = [...guides].sort((a, b) => a.order - b.order);
const idx = ordered.findIndex(g => g.slug === slug);
const prev = idx > 0 ? ordered[idx - 1] : null;
const next = idx >= 0 && idx < ordered.length - 1 ? ordered[idx + 1] : null;
---
<Landing title={`${guide.title_en} — Forgeplan Guides`} description={guide.desc_en}>
  <Header />
  <link slot="head" rel="canonical" href={canonical} />
  <link slot="head" rel="alternate" hreflang="en" href={canonical} />
  <link slot="head" rel="alternate" hreflang="ru" href={altRu} />
  <link slot="head" rel="alternate" hreflang="x-default" href={canonical} />
  <script slot="head" type="application/ld+json" set:html={safeJson(ld)} />
  <script slot="head" type="application/ld+json" set:html={safeJson(breadcrumbs)} />
  <SiteJsonLd lang="en" />

  <article class="guide-page">
    <main id="main-content" class="guide-main">
      <nav class="guide-breadcrumb" aria-label="Breadcrumb">
        <a href="/guides">← All guides</a>
      </nav>

      <header class="guide-header">
        <p class="guide-eyebrow">
          <span class={`guides-card-pill guides-pill-${guide.pill}`}>{guide.pill}</span>
          <span>#{String(guide.order).padStart(2, '0')} · {guide.tag_en}</span>
        </p>
        <h1>{guide.title_en}</h1>
        <p class="guide-summary">{guide.desc_en}</p>
        <p class="guide-lang-note">
          <a href={altRu}>Читать на русском →</a>
          <span class="guide-lang-note-sep">·</span>
          <span>Lesson content is in Russian (translation in progress)</span>
        </p>
      </header>

      <div class="guide-frame-wrap">
        <iframe
          src={`/guides-raw/${slug}.html`}
          title={guide.title_en}
          class="guide-frame"
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups"
        />
      </div>

      <nav class="guide-prevnext" aria-label="Reading order navigation">
        <div class="guide-prevnext-cell">
          {prev ? (
            <a href={`/guides/${prev.slug}`}>
              <span class="guide-prevnext-dir">← Previous</span>
              <span class="guide-prevnext-title">#{String(prev.order).padStart(2, '0')} · {prev.title_en}</span>
            </a>
          ) : <span class="guide-prevnext-empty">— Start of series</span>}
        </div>
        <div class="guide-prevnext-cell guide-prevnext-next">
          {next ? (
            <a href={`/guides/${next.slug}`}>
              <span class="guide-prevnext-dir">Next →</span>
              <span class="guide-prevnext-title">#{String(next.order).padStart(2, '0')} · {next.title_en}</span>
            </a>
          ) : <span class="guide-prevnext-empty">End of series —</span>}
        </div>
      </nav>
    </main>
  </article>
  <BlogFooter lang="en" />
</Landing>
