---
import '../styles/global.css';
import SiteJsonLd from '../components/SiteJsonLd.astro';
import LandingMeta from '../components/LandingMeta.astro';
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ru';
  slug?: string;
  includeSoftware?: boolean;
}

const {
  title = 'Forgeplan — From Raw Idea to Proven Decision',
  description = 'Engineering methodology for decisions that last — structured project artifacts with quality scoring, evidence tracking, and semantic search.',
  lang = 'en',
  slug = '',
  includeSoftware = false,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Prevent flash: apply saved theme before render -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('forgeplan-theme');
        if (t === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" id="favicon-link" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      // Theme-aware favicon swap (dark default; light when html.light)
      (function() {
        function updateFavicon() {
          var l = document.getElementById('favicon-link');
          if (!l) return;
          var isLight = document.documentElement.classList.contains('light');
          l.href = isLight ? '/favicon-light.svg' : '/favicon-dark.svg';
        }
        // Run on load (after theme script in body may have toggled class)
        updateFavicon();
        // Watch class changes on <html>
        new MutationObserver(updateFavicon).observe(document.documentElement, {
          attributes: true, attributeFilter: ['class']
        });
      })();
    </script>
    <title>{title}</title>
    <LandingMeta title={title} description={description} lang={lang} slug={slug} />
    {/* GSC ownership verified via DNS TXT (Domain property covers all subdomains/protocols) — no HTML tag needed */}
    <SiteJsonLd lang={lang} includeSoftware={includeSoftware} />
  </head>
  <body class="bg-forge-bg text-forge-fg font-body antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[9999] focus:bg-forge-ember focus:text-forge-bg focus:px-4 focus:py-2 focus:text-sm">
      Skip to content
    </a>
    <slot />
    {/* Cloudflare Web Analytics injected automatically via 'Deploy with automatic setup' at the CF edge (domain on CF), no manual beacon script needed */}
  </body>
</html>
