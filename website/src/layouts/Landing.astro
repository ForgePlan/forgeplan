---
import '../styles/global.css';
import SiteJsonLd from '../components/SiteJsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ru';
}

const {
  title = 'Forgeplan — From Raw Idea to Proven Decision',
  description = 'Engineering methodology for decisions that last — structured project artifacts with quality scoring, evidence tracking, and semantic search.',
  lang = 'en',
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Prevent flash: apply saved theme before render -->
    <script is:inline>
      (function() {
        var t = localStorage.getItem('forgeplan-theme');
        if (t === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" id="favicon-link" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      // Theme-aware favicon swap (dark default; light when html.light)
      (function() {
        function updateFavicon() {
          var l = document.getElementById('favicon-link');
          if (!l) return;
          var isLight = document.documentElement.classList.contains('light');
          l.href = isLight ? '/favicon-light.svg' : '/favicon-dark.svg';
        }
        // Run on load (after theme script in body may have toggled class)
        updateFavicon();
        // Watch class changes on <html>
        new MutationObserver(updateFavicon).observe(document.documentElement, {
          attributes: true, attributeFilter: ['class']
        });
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <SiteJsonLd lang={lang} />
  </head>
  <body class="bg-forge-bg text-forge-fg font-body antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[9999] focus:bg-forge-ember focus:text-forge-bg focus:px-4 focus:py-2 focus:text-sm">
      Skip to content
    </a>
    <slot />
  </body>
</html>
