---
import Header from '../components/Header.astro';
import Hero from '../components/blog/Hero.astro';
import TOC from '../components/blog/TOC.astro';
import SeriesNav from '../components/blog/SeriesNav.astro';
import SeoMeta from '../components/blog/SeoMeta.astro';
import RelatedPosts from '../components/blog/RelatedPosts.astro';
import BlogFooter from '../components/blog/BlogFooter.astro';
import SiteJsonLd from '../components/SiteJsonLd.astro';
// global.css MUST come first — Header.astro uses Tailwind utilities
// (hidden, lg:grid, bg-forge-bg, etc.) defined here.
import '../styles/global.css';
import '../styles/blog-theme.css';
// Self-hosted fonts via @fontsource — replaces Google Fonts CDN <link> tags (FIX-2).
// package.json declares @fontsource/space-grotesk and @fontsource/geist-mono.
import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  lang: 'en' | 'ru';
  kind: string;
  topic: string;
  readingTime?: number;
  translations?: Record<string, string>;
  cover?: string;
  series?: string;
  currentId?: string;
  headings?: { depth: number; slug: string; text: string }[];
  slug: string;
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  lang,
  kind,
  topic,
  readingTime,
  translations,
  cover,
  series,
  currentId,
  headings = [],
  slug,
} = Astro.props;

const oppositeLang = lang === 'en' ? 'ru' : 'en';
const oppositeSlug = translations?.[oppositeLang];
const oppositeUrl = oppositeSlug
  ? (oppositeLang === 'en' ? `/blog/${oppositeSlug}` : `/ru/blog/${oppositeSlug}`)
  : null;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <script is:inline>
      (function() {
        var t = localStorage.getItem('forgeplan-theme');
        if (t === 'light') {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else if (!t && matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" id="favicon-link" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <script is:inline>
      (function() {
        function updateFavicon() {
          var l = document.getElementById('favicon-link');
          if (!l) return;
          var isLight = document.documentElement.classList.contains('light');
          l.href = isLight ? '/favicon-light.svg' : '/favicon-dark.svg';
        }
        updateFavicon();
        new MutationObserver(updateFavicon).observe(document.documentElement, {
          attributes: true, attributeFilter: ['class']
        });
      })();
    </script>
    <title>{title} {lang === 'ru' ? '— Блог Forgeplan' : '— Forgeplan Blog'}</title>
    <SeoMeta
      title={title}
      description={description}
      lang={lang}
      cover={cover}
      publishedAt={publishedAt}
      updatedAt={updatedAt}
      translations={translations}
      slug={slug}
      topic={topic}
      tags={[topic, series].filter(Boolean) as string[]}
    />
    <SiteJsonLd lang={lang} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {lang === 'ru' ? 'Перейти к содержимому' : 'Skip to content'}
    </a>
    <Header />
    <article class="blog-post">
      <Hero cover={cover} topic={topic} kind={kind} title={title} />
      <div class="blog-layout">
        <main id="main-content" class="blog-content">
          <p class="blog-description">{description}</p>
          <slot />
          {series && currentId && <SeriesNav currentId={currentId} currentSeries={series} lang={lang} />}
          <RelatedPosts slug={slug} lang={lang} topic={topic} series={series} />
          {oppositeUrl && (
            <footer class="blog-lang-switch">
              <a href={oppositeUrl}>
                {oppositeLang === 'ru' ? 'Читать на русском →' : 'Read in English →'}
              </a>
            </footer>
          )}
        </main>
        <TOC
          headings={headings}
          lang={lang}
          publishedAt={publishedAt}
          updatedAt={updatedAt}
          readingTime={readingTime}
          topic={topic}
          title={title}
          slug={slug}
        />
      </div>
    </article>
    <BlogFooter lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: -9999px;
  }
  .skip-link:focus {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 1000;
    padding: 12px 18px;
    background: var(--forge-ember, #FF6B35);
    color: #050505;
    font-weight: 600;
    text-decoration: none;
  }
</style>
